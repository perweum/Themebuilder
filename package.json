{
  "name": "systemic-theme-builder",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsgo --noEmit || tsc --noEmit",
    "verify": "run-p lint format:check typecheck test"
  },
  "dependencies": {
    "culori": "^3.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.575.0",
    "react": "^18.2.0",
    "react-aria-components": "^1.15.1",
    "react-colorful": "^5.6.1",
    "react-dom": "^18.2.0",
    "react-fontpicker-ts": "^1.3.0"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/jszip": "^3.4.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript/native-preview": "^7.0.0-dev.20260427.1",
    "@vitejs/plugin-react": "^4.0.0",
    "gh-pages": "^6.3.0",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^5.0.0",
    "vite": "^4.0.0",
    "vitest": "^4.1.5"
  }
}
